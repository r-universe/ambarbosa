	branch = HEAD
[submodule "ecotrends"]
	path = ecotrends
	url = https://github.com/ambarbosa/ecotrends
[submodule "fuzzySim"]
	path = fuzzySim
	url = https://github.com/ambarbosa/fuzzysim
[submodule "modEvA"]
	path = modEvA
	url = https://github.com/ambarbosa/modeva
